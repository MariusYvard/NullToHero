root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,gif,ico,webp,avif,mp4,pdf,woff,woff2,ttf,otf}]
charset = unset
insert_final_newline = false
trim_trailing_whitespace = false
